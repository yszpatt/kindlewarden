# 复制为 .env 后填写。.env 不进版本库，本文件进。
# 约定：环境变量优先于 .env 文件（代码里先读 env，再读 .env）。

# ============================================================
# WorkTime 外设链路
# ============================================================

# --- 项目看板 project-manager ---
PM_URL=http://192.168.9.57:8930
PM_USER=pm
PM_PASSWORD=
# MCP 的 Authorization 头（填完 PM_PASSWORD 后可用 worktime.py 生成）
#   printf 'pm:<口令>' | base64 -w0
PM_MCP_AUTH=
PM_PROJECT_ID=kindlewarden

# --- Kindle 副屏 kindlewarden ---
WARDEN_URL=http://192.168.9.57:8577

# --- 小爱音箱 mi-voice ---
MIVOICE_URL=http://192.168.9.57:3001

# ============================================================
# 包管理器镜像（国内）
# ============================================================
npm_config_registry=https://registry.npmmirror.com
# pip 走清华源
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
