# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
.pytest-tmp/
.pytest_cache/
# 沙箱垫片生效前创建的目录，权限已损坏、无法删除，也读不到
pytest-cache-files-*/

# 本地运行时数据（事件日志、面板配置、设备端状态）
.runtime/

# 开发环境沙箱垫片与临时依赖（见 .tools/sitecustomize.py 的说明）
.tools/
.uv-cache/

# 生成物
dist/
mockups/out/

# 编辑器
.vscode/
.idea/
*.swp

# ======================================================================
# WorkTime：仓库里只放项目代码
# 编辑器配置、技能副本、MCP 配置、本机凭据都算「本机开发环境」，
# 换台机器就该重新生成，提交上去只会互相打架、还会把本机情况带出去。
# ======================================================================

# ---- WorkTime 本地凭据 / 机器相关配置 ----
# 含看板 Basic 口令，绝不能进版本库。
.worktime/
.mcp.json

# ---- 各编辑器的技能 / MCP / 规则副本（本机开发环境）----
# 规则正文留在仓库根的 AGENTS.md，那才是要提交的那一份。
.workbuddy/
.codebuddy/
.claude/
.cursor/
.clinerules/
.dsh/

# ---- 环境变量 ----
.env
.env.*
!.env.example
